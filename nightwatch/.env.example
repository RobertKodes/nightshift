# A FRESH wallet that holds only the bot's funds: some ETH for gas, and the imdUSD you want to liquidate with.
# Never the wallet that holds your Night Watcher. Keep this file private (chmod 600 .env).
KEEPER_MNEMONIC="word word word word word word word word word word word word"
# or: KEEPER_PRIVATE_KEY=0x...

# Optional
# NIGHTWATCH_SITE=https://getnightshift.tech
# READ_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org
# SEND_RPC_URL=https://rpc.mevblocker.io
# POLL_SECONDS=15
# MAX_GAS_GWEI=30
# MIN_ETH=0.003
# TIP_GWEI=0.5
